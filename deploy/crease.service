[Unit]
Description=Crease private repository server
After=network.target

[Service]
Type=simple
User=crease
Group=crease
StateDirectory=crease
StateDirectoryMode=0700
ExecStart=/usr/local/bin/crease serve --data /var/lib/crease --listen :2222 --owner-key /etc/crease/owner.pub
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crease

[Install]
WantedBy=multi-user.target
